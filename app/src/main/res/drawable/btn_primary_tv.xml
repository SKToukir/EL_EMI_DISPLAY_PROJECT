<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#3B82F6" />
                </shape>
            </item>
            <!-- white outline ring -->
            <item android:left="-5dp" android:top="-5dp" android:right="-5dp" android:bottom="-5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <stroke android:width="2dp" android:color="@android:color/white" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <!-- blue glow -->
            <item android:left="-10dp" android:top="-10dp" android:right="-10dp" android:bottom="-10dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <stroke android:width="4dp" android:color="#553B82F6" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#1D4ED8" />
        </shape>
    </item>
</selector>