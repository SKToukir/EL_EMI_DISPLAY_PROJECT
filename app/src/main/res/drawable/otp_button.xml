<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="false">
        <shape android:innerRadius="0dp" android:shape="rectangle" android:thicknessRatio="8" android:useLevel="false">
            <size android:height="48dp" android:width="48dp" />
            <corners android:radius="24dp" />
            <gradient android:centerColor="#ffffff" android:endColor="#ffffff" android:startColor="#ffffff" android:type="sweep" android:useLevel="false" />
        </shape>
    </item>
    <item android:state_focused="true" android:state_pressed="true">
        <shape android:innerRadius="0dp" android:shape="rectangle" android:thicknessRatio="8" android:useLevel="false">
            <size android:height="48dp" android:width="48dp" />
            <corners android:radius="24dp" />
            <gradient android:centerColor="#f2f2f2" android:endColor="#f2f2f2" android:startColor="#f2f2f2" android:type="sweep" android:useLevel="false" />
        </shape>
    </item>
    <item>
        <shape android:innerRadius="0dp" android:shape="rectangle" android:thicknessRatio="8" android:useLevel="false">
            <size android:height="48dp" android:width="48dp" />
            <corners android:radius="24dp" />
            <gradient android:centerColor="#000000" android:endColor="#000000" android:startColor="#000000" android:type="sweep" android:useLevel="false" />
        </shape>
    </item>
</selector>