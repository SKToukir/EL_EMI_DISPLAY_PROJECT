<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- STATE 1: Focused or Pressed (Solid Fill) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_focused_fill"/>
            <corners android:radius="50dp"/> <!-- High radius for pill shape -->
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_focused_fill"/>
            <corners android:radius="50dp"/>
        </shape>
    </item>

    <!-- STATE 2: Default/Normal (Transparent with Stroke) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="2dp" android:color="@color/btn_outline_stroke"/>
            <corners android:radius="50dp"/>
        </shape>
    </item>

</selector>