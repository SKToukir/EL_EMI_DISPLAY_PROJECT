<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingStart="36dp"
    android:paddingEnd="36dp"
    android:paddingTop="36dp"
    android:paddingBottom="32dp"
    android:layout_width="820dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/dialog_background_gorgeous"
    android:gravity="center_horizontal">

    <!-- Top accent line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@drawable/accent_line_gradient"
        android:layout_marginBottom="28dp" />

    <!-- Header: Icon + Badge + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginBottom="22dp">

        <!-- Icon container -->
        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/warning_icon_bg_gorgeous"
            android:layout_marginEnd="18dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_warning_triangle"
                android:tint="#FFA040" />
        </FrameLayout>

        <!-- Title block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginTop="2dp">

            <!-- "Action Required" badge pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/badge_amber_background"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="@drawable/dot_amber"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTION REQUIRED"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFA040"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <!-- Main title -->
            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is title"
                android:textSize="24sp"
                android:fontFamily="sans-serif-black"
                android:textColor="@android:color/white"
                android:letterSpacing="-0.02" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/divider_fade"
        android:layout_marginBottom="20dp" />

    <!-- Body text -->
    <TextView
        android:id="@+id/txtMessageWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/warning_message"
        android:textColor="#94FFFFFF"
        android:textSize="18sp"
        android:lineSpacingMultiplier="1.6"
        android:fontFamily="sans-serif-light"
        android:layout_marginBottom="20dp" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelWarning"
            android:layout_width="140dp"
            android:layout_height="54dp"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:padding="5dp"
            android:layout_margin="5dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:focusedByDefault="true"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_ghost_gorgeous"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:textSize="19sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01" />
    </LinearLayout>

    <!-- Remote navigation hint -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/remote_nav_hint"
        android:textSize="13sp"
        android:textColor="#38FFFFFF"
        android:gravity="end"
        android:fontFamily="sans-serif"
        android:layout_marginTop="10dp"
        android:letterSpacing="0.03" />

</LinearLayout>