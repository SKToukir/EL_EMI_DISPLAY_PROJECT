<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="700dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/dialog_background"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/warning_dialog_message"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FFC107"
        android:layout_marginBottom="8dp" />

    <TextView
        android:fontFamily="sans-serif"
        android:id="@+id/txtBodyDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FF9100"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/caution_display_message"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:layout_marginBottom="14dp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_barcode_box">

        <!-- Barcode -->
        <TextView
            android:gravity="center"
            android:id="@+id/txtBarcode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Barcode: WSD55215DE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="@android:color/darker_gray"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>

        <!-- Passcode -->
        <TextView
            android:gravity="center"
            android:layout_weight="0.5"
            android:id="@+id/txtPasscode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Passcode: 4589"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_enter_pin"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_input_field"
            android:hint="Enter PIN"
            android:textColorHint="#9AA0A6"
            android:textColor="@color/btn_text_color"
            android:textSize="18sp"
            android:drawableStart="@drawable/ic_payment"
            android:drawablePadding="12dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:textCursorDrawable="@null"
            android:singleLine="true"/>

        <TextView
            android:id="@+id/txtErrorMessage"
            android:layout_marginTop="35dp"
            android:layout_marginStart="15dp"
            android:layout_below="@+id/et_enter_pin"
            android:textColor="#E70000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Button
            android:layout_centerVertical="true"
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/cancel"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textAllCaps="false"
            android:layout_toLeftOf="@id/btnConfirm"
            android:textColor="@android:color/white"
            android:background="@drawable/unselected_button"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:minHeight="48dp"
            android:textSize="16sp" />

        <Button
            android:layout_marginEnd="25dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:id="@+id/btnConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/confirm"
            android:textAllCaps="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="@android:color/white"
            android:background="@drawable/unselected_button"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:minHeight="48dp"
            android:textSize="16sp" />
    </RelativeLayout>
</LinearLayout>
