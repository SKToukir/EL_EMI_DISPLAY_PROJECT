<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <EditText
        android:id="@+id/et_enter_pin"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_input_field"
        android:hint="Enter PIN"
        android:textColorHint="#9AA0A6"
        android:textColor="@color/btn_text_color"
        android:textSize="18sp"
        android:inputType="numberPassword"
        android:drawableStart="@drawable/ic_payment"
        android:drawablePadding="12dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:textCursorDrawable="@null"
        android:singleLine="true" />

    <TextView
        android:id="@+id/txtErrorMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/et_enter_pin"
        android:layout_marginStart="15dp"
        android:layout_marginTop="8dp"
        android:textColor="#E70000"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@id/btnConfirm"
        android:layout_marginEnd="12dp"
        android:text="@string/cancel"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:background="@drawable/unselected_button"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:minHeight="48dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="25dp"
        android:text="@string/confirm"
        android:textAllCaps="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:textColor="@android:color/white"
        android:background="@drawable/unselected_button"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:minHeight="48dp"
        android:textSize="16sp" />

</RelativeLayout>